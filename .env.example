# Optional local overrides (copy to .env.local, then restart with `npx expo start -c`)

# Which backend set to use: local | dev | qa | prod (rows in src/core/config/servers.ts).
# Defaults to the build's APP_ENV. `local` = ERP on dev + mobile API from `make up` on this machine.
# EXPO_PUBLIC_SERVER=local

# Point one backend somewhere else, overriding the row above.
# EXPO_PUBLIC_ERP_URL=http://192.168.2.57:8113
# EXPO_PUBLIC_MOBILE_API_URL=http://192.168.3.188:8000/api/v1

# EXPO_PUBLIC_IDLE_TIMEOUT_MINUTES=30
