# Optional local overrides (copy to .env.local, then restart with `npx expo start -c`)

# Which Django server to use: local | dev | qa | prod (rows in src/core/config/servers.ts).
# Defaults to the build's APP_ENV. `local` = Django on this machine, port 8000.
# EXPO_PUBLIC_SERVER=local

# Point at any other Django server, overriding the row above.
# EXPO_PUBLIC_ERP_URL=http://192.168.2.57:8113

# EXPO_PUBLIC_IDLE_TIMEOUT_MINUTES=30

# Log every API request with running counts (dev builds only), to spot repeated calls.
# EXPO_PUBLIC_LOG_API=1
