    "preview": { "distribution": "internal", "android": { "buildType": "apk" }, "env": { "APP_ENV": "dev" }, "channel": "preview" },
    "qa": { "distribution": "internal", "android": { "buildType": "apk" }, "env": { "APP_ENV": "qa" }, "channel": "qa" },
